{
  "expo": {
    "name": "BarangayAI",
    "slug": "BarangayAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barangayai",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "imageWidth": 76,
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BarangayAI to use your camera for QR scanning and resident ID capture."
        }
      ],
      "expo-image-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow BarangayAI to record voice questions for Ate Sora."
        }
      ],
      [
        "expo-ai-kit",
        {
          "llm": true,
          "speech": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
